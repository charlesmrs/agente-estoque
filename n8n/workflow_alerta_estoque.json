    {
      "parameters": {
        "jsCode": "// Transforma a resposta do agente em uma linha por produto crítico\nconst r = $input.first().json;\nconst agora = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nreturn r.alertas.map(a => ({\n  json: {\n    data_verificacao: agora,\n    codigo: a.codigo,\n    produto: a.nome,\n    quantidade_atual: a.quantidade_atual,\n    estoque_minimo: a.estoque_minimo,\n    situacao: a.situacao,\n    repor_ao_menos: a.falta_para_minimo,\n    prioridade: ['ESGOTADO', 'CRITICO'].includes(a.situacao) ? 'ALTA' : 'MÉDIA'\n  }\n}));"
      },
